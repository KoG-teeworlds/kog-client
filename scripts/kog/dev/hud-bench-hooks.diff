diff --git a/src/game/client/components/kog/kog_fixture.cpp b/src/game/client/components/kog/kog_fixture.cpp
new file mode 100644
index 000000000..b5a55f280
--- /dev/null
+++ b/src/game/client/components/kog/kog_fixture.cpp
@@ -0,0 +1,93 @@
+#include "kog_fixture.h"
+// LOCAL screenshot and benchmark fixture, not committed: fills the game client with N fake players, chat lines and kills so that
+// the real scoreboard, chat and kill feed components draw offline. KOG_FIXTURE=<number of players>.
+#include <engine/shared/config.h>
+#include <engine/textrender.h>
+
+#include <generated/protocol.h>
+
+#include <game/client/component.h>
+#include <game/client/gameclient.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+void CKogFixture::OnRender()
+{
+		const char *pEnv = getenv("KOG_FIXTURE");
+		if(pEnv == nullptr)
+			return;
+		if(!m_Done)
+		{
+			m_Done = true;
+			m_Num = std::clamp(atoi(pEnv), 1, 128);
+			const char *apNames[] = {"Aqua", "Pixel", "Rex", "You", "Nova", "Bolt", "Kira", "Mono", "Zed", "Lux", "Frost", "Ember", "Quill", "Tango", "Vex", "Orbit"};
+			const char *apClans[] = {"KoG", "", "Fox", "Tee", "", "Gore", "TH", "KoG"};
+			auto &Snap = GameClient()->m_Snap;
+			Snap = {};
+			for(int i = 0; i < m_Num; i++)
+			{
+				CNetObj_PlayerInfo &Info = m_aInfos[i];
+				Info = {};
+				Info.m_Local = i == 3;
+				Info.m_ClientId = i;
+				Info.m_Team = TEAM_RED;
+				Info.m_Score = 12000 - i * 83;
+				Info.m_Latency = 18 + (i * 37) % 130;
+				Snap.m_apPlayerInfos[i] = &Info;
+				Snap.m_apInfoByScore[i] = &Info;
+				Snap.m_apInfoByDDTeamScore[i] = &Info;
+				auto &Client = GameClient()->m_aClients[i];
+				char aName[32];
+				if(i == 5)
+					str_copy(aName, "AVeryLongPlayerNameIndeed_12345");
+				else if(i < 16)
+					str_copy(aName, apNames[i]);
+				else
+					str_format(aName, sizeof(aName), "%s%d", apNames[i % 16], i);
+				str_copy(Client.m_aName, aName);
+				str_copy(Client.m_aClan, i == 9 ? "LongClanNameHere" : apClans[i % 8]);
+				Client.m_Active = true;
+				Client.m_Team = TEAM_RED;
+				Client.m_Country = -1;
+				str_copy(Client.m_aSkinName, i % 3 == 0 ? "default" : (i % 3 == 1 ? "cammostripes" : "kitty"));
+				Client.UpdateSkinInfo();
+			}
+			Snap.m_NumPlayers = m_Num;
+			Snap.m_aTeamSize[TEAM_RED] = m_Num;
+			Snap.m_aTeamSize[TEAM_BLUE] = 0;
+			Snap.m_LocalClientId = 3;
+			Snap.m_pLocalInfo = &m_aInfos[3];
+			GameClient()->m_aLocalIds[0] = 3;
+			static const struct
+			{
+				int m_Id;
+				const char *m_pText;
+				int m_Team;
+			} aChat[] = {{0, "anyone up for a team run?", 0}, {1, "sure, joining now", 0}, {-1, "Pixel joined team 2", 0}, {3, "need a hook at gate 2", 1}, {-1, "Quest completed: No hammer", 0}, {5, "this is a rather long chat line that has to wrap over more than one row of the chat box", 0}};
+			for(const auto &Line : aChat)
+				GameClient()->m_Chat.AddLine(Line.m_Id, Line.m_Team, Line.m_pText);
+			static const int aKills[][3] = {{0, 1, 5}, {2, 5, 1}, {4, 4, -1}, {5, 6, 4}};
+			for(const auto &Kill : aKills)
+			{
+				CNetMsg_Sv_KillMsg Msg;
+				Msg.m_Killer = Kill[0];
+				Msg.m_Victim = Kill[1];
+				Msg.m_Weapon = Kill[2];
+				Msg.m_ModeSpecial = 0;
+				GameClient()->m_InfoMessages.OnMessage(NETMSGTYPE_SV_KILLMSG, &Msg);
+			}
+		}
+		// keep the fixture in place: the snapshot code of an offline client clears it
+		auto &Snap = GameClient()->m_Snap;
+		for(int i = 0; i < m_Num; i++)
+		{
+			Snap.m_apPlayerInfos[i] = &m_aInfos[i];
+			Snap.m_apInfoByDDTeamScore[i] = &m_aInfos[i];
+			Snap.m_apInfoByScore[i] = &m_aInfos[i];
+		}
+		Snap.m_NumPlayers = m_Num;
+		Snap.m_aTeamSize[TEAM_RED] = m_Num;
+		Snap.m_pLocalInfo = &m_aInfos[3];
+}
